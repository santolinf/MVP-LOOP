# Copy to .env.vm-dev on the VM and replace every CHANGE_ME. Never commit .env.vm-dev.
# Generate secrets with:  openssl rand -hex 32     (Postgres password must be URL-safe: hex is)

# --- Postgres ---
POSTGRES_USER=loop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=loop

# --- App ---
SESSION_SECRET=CHANGE_ME_min_32_chars
JWT_SECRET=CHANGE_ME_min_32_chars
# The address a tester types in their browser. Email links are built from it.
#   IAP tunnel (recommended):  http://localhost:3000
#   Direct (firewall-limited): http://<VM external IP>:3000
APP_BASE_URL=http://localhost:3000
# Where browsers reach MinIO for presigned CV upload/download URLs (same host as above, port 9000).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- MinIO (S3 keys are also its root login; use long random values) ---
S3_ACCESS_KEY_ID=CHANGE_ME_min_16_chars
S3_SECRET_ACCESS_KEY=CHANGE_ME_min_32_chars

# --- Malware scanner (app token = scanner token), min 32 chars ---
CLAMAV_AUTH_TOKEN=CHANGE_ME_min_32_chars

# --- Upload quotas (optional) ---
# Anonymous CV uploads are limited per client IP per hour. Through the tunnel every tester shares one IP, so the app's
# default of 5 is exhausted within minutes (HTTP 429 "Too many uploads"). These dev defaults are generous.
# CV_ANON_UPLOADS_PER_IP_PER_HOUR=200
# CV_ANON_UPLOADS_GLOBAL_PER_HOUR=2000

# --- Compose ---
# 127.0.0.1 = reachable only through an SSH/IAP tunnel (recommended). 0.0.0.0 = open to whatever the VPC firewall allows.
BIND_ADDRESS=127.0.0.1
LOOP_TAG=dev
