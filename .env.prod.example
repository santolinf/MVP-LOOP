# Copy to .env.prod and replace every CHANGE_ME. Never commit .env.prod.
# Generate secrets with:  openssl rand -base64 48

# --- Postgres (used by the postgres, migrate and app services) ---
POSTGRES_USER=loop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=loop

# --- Compose ---
# Host port the app is published on (container always listens on 3000)
APP_PORT=3000
# Image tag for built images
LOOP_TAG=latest

# --- App (apps/api/src/config) ---
# NODE_ENV, APP_ROLE, PORT and DATABASE_URL are set by the compose file.
# Required in production, minimum 32 characters each:
SESSION_SECRET=CHANGE_ME_min_32_chars
JWT_SECRET=CHANGE_ME_min_32_chars

# Public URL used in referral links (no trailing slash)
PUBLIC_BASE_URL=https://loop.example.com

# --- Email (optional; sign-in links need an SMTP server to be sent) ---
EMAIL_FROM=LOOP <no-reply@loop.example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# Feature flags for payouts, profit sharing and agency access stay off in production.
