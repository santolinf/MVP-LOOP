# Copy to .env.prod and replace every CHANGE_ME. Never commit .env.prod.
# Generate secrets with:  openssl rand -base64 48

# --- Postgres (used by the postgres, migrate and app services) ---
POSTGRES_USER=loop
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=loop

# --- Compose ---
# Host port the app is published on (container always listens on 3000)
APP_PORT=3000
# Image tag for built images
LOOP_TAG=latest

# --- App (apps/api/src/config) ---
# NODE_ENV, APP_ROLE, PORT and DATABASE_URL are set by the compose file.
# Required in production, minimum 32 characters each:
SESSION_SECRET=CHANGE_ME_min_32_chars
JWT_SECRET=CHANGE_ME_min_32_chars

# Public URL used in referral links (no trailing slash)
PUBLIC_BASE_URL=https://loop.example.com

# --- Email: any SMTP provider (ADR 0013; recipes in docs/cloud-environment/deploy-email.md) ---
EMAIL_FROM=LOOP <no-reply@loop.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Bounce/complaint webhook (POST /webhooks/email, Basic auth password), min 16 chars:  openssl rand -hex 24
EMAIL_WEBHOOK_SECRET=CHANGE_ME_min_16_chars
# Optional provider-specific alternative: POSTMARK_SERVER_TOKEN + POSTMARK_WEBHOOK_SECRET

# --- CV storage: any private S3-compatible bucket (ADR 0012; recipes in docs/cloud-environment/deploy-storage-and-scanning.md) ---
# UK region only. Leave S3_ENDPOINT out for AWS S3; set it for GCS (https://storage.googleapis.com), R2, MinIO, etc.
# S3_ENDPOINT=
S3_REGION=CHANGE_ME_provider_region
S3_BUCKET=loop-cv
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=true   # MinIO and most self-hosted stores

# --- Malware scanner: any host of the infra/clamav-scanner image (or another implementation of POST /scan) ---
CLAMAV_URL=https://scanner.example.com
# Same value as the scanner's AUTH_TOKEN, minimum 32 characters:  openssl rand -hex 32
CLAMAV_AUTH_TOKEN=CHANGE_ME_min_32_chars

# Feature flags for payouts, profit sharing and agency access stay off in production.
