  "components": {
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "live": {
            "type": "boolean"
          },
          "paused": {
            "type": "boolean"
          },
          "employment": {
            "type": "string",
