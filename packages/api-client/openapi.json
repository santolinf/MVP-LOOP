            "nullable": true
          },
          "availability": {
            "type": "object",
            "properties": {
              "colour": {
                "type": "string",
                "enum": [
                  "LIME",
                  "ORANGE",
                  "RED",
                  "BLUE",
                  "GREY"
                ]
              },
              "label": {
                "type": "string"
              },
              "lastConfirmedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "nullable": true
              },
              "nextCheckAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "nullable": true
              }
            },
            "required": [
              "colour",
              "label",
              "lastConfirmedAt",
              "nextCheckAt"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "live",
          "paused",
          "employment",
          "availableFrom",
          "availability"
        ]
      },
      "ConfirmAvailabilityDto": {
        "type": "object",
        "properties": {
          "employment": {
            "type": "string",
            "enum": [
              "CONTRACTING",
              "PERMANENT",
              "BETWEEN_CONTRACTS"
            ]
          },
          "availableFrom": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
