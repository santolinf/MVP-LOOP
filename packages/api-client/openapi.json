          },
          "code": {
            "type": "string",
            "pattern": "^\\d{4,10}$"
          },
          "clientType": {
            "type": "string",
            "enum": [
              "WEB",
              "MOBILE_APP"
            ]
          },
          "purpose": {
            "default": "SIGN_IN",
            "type": "string",
            "enum": [
              "REGISTER",
              "SIGN_IN"
            ]
          },
          "registration": {
            "type": "object",
            "properties": {
              "firstName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "lastName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "mobile": {
                "type": "string",
                "minLength": 10,
                "maxLength": 20
              },
              "termsAccepted": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "marketingOptIn": {
                "type": "boolean"
              }
            },
            "required": [
              "firstName",
              "lastName",
              "mobile",
              "termsAccepted",
              "marketingOptIn"
            ]
          },
          "attestation": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "IOS",
                  "ANDROID"
                ]
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "platform",
              "token"
            ]
          }
        },
        "required": [
          "email",
          "code",
          "clientType"
        ]
      },
      "AuthResultDto": {
        "type": "object",
        "properties": {
          "contractorId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
