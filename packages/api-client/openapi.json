  "components": {
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "REGISTER",
              "SIGN_IN"
            ]
          },
          "clientType": {
            "type": "string",
            "enum": [
              "WEB",
              "MOBILE_APP"
            ]
          }
        },
        "required": [
          "email",
          "purpose",
          "clientType"
        ]
      },
      "OtpRequestResultDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "resendAfterSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "accepted",
          "resendAfterSeconds"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
