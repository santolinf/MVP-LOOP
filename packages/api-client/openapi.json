                  "nullable": true
                },
                "current": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "clientType",
                "createdAt",
                "lastUsedAt",
                "current"
              ]
            }
          }
        },
        "required": [
          "items"
