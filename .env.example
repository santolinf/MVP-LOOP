NODE_ENV=development
APP_ROLE=all
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://loop:loop@localhost:5432/loop?schema=public

# Auth (generate real secrets outside local dev)
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
DRAFT_TOKEN_SECRET=dev-only-draft-secret-change-me-0123456789
LINK_SIGNING_SECRET=dev-only-link-secret-change-me-0123456789

# Object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=loop-cv
S3_FORCE_PATH_STYLE=true

# CV intake limits (placeholders until OQ2 is decided)
CV_MAX_BYTES_ANON=5242880
CV_MAX_BYTES_AUTH=10485760
CV_ORPHAN_TTL_HOURS=24
CV_PRESIGN_TTL_SECONDS=300
CV_ANON_UPLOADS_PER_IP_PER_HOUR=5
CV_ANON_UPLOADS_GLOBAL_PER_HOUR=500

# Malware scanner (compose service clamav-scanner; same HTTP contract as production, ADR 0012)
CLAMAV_URL=http://localhost:8080
CLAMAV_AUTH_TOKEN=dev-only-clamav-token-0123456789abcdef

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit has no TLS. Production defaults to SMTP_TLS=starttls and requires SMTP_USER/SMTP_PASSWORD.
# SMTP_TLS=none
# Phase 8: production email via Postmark (leave unset locally; SMTP/Mailpit is used instead).
# POSTMARK_SERVER_TOKEN=
# Basic-auth password you put in the Postmark webhook URL (min 16 chars). Required with the token.
# POSTMARK_WEBHOOK_SECRET=
# Public site origin used for links in emails, and how long a one-touch confirm link lasts.
APP_BASE_URL=http://localhost:3000
CONFIRM_LINK_TTL_HOURS=72
EMAIL_FROM=no-reply@loop.local

# LLM (CV extraction) - use a spend cap
LLM_API_KEY=
LLM_MODEL=

# Wise (payouts disabled)
WISE_API_TOKEN=
WISE_WEBHOOK_PUBLIC_KEY=

# Public URLs
PUBLIC_BASE_URL=http://localhost:3000
